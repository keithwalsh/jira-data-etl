# Jira Cloud. Basic auth with your Atlassian account email and an API token.
# Leave both blank to request anonymously (public instances such as issues.apache.org/jira).
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_DOMAIN=yourcompany.atlassian.net

# MySQL target only (--to mysql). The four tables must already exist (see README).
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
